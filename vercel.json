{
  "rewrites": [
    {
      "source": "/v",
      "destination": "/valorar.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa.html"
    },
    {
      "source": "/nuevo",
      "destination": "/nuevo.html"
    },
    {
      "source": "/participacion-ciudadana",
      "destination": "/participacion-ciudadana.html"
    },
    {
      "source": "/sala",
      "destination": "/sala.html"
    },
    {
      "source": "/mapa2",
      "destination": "/mapa2.html"
    },
    {
      "source": "/empresas",
      "destination": "/empresas.html"
    },
    {
      "source": "/sitemap-dinamico.xml",
      "destination": "/api/public?sitemap=1"
    },
    {
      "source": "/mapa/:c/:l",
      "destination": "/api/public?c=:c&l=:l"
    },
    {
      "source": "/mapa/:c",
      "destination": "/api/public?c=:c"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/avatar.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ]
}